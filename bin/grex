#!/usr/bin/env python3
"""Grex CLI — Sovereign Component & Telemetry Control Utility for Hermes."""

import sys
import json
import urllib.request

def main():
    args = sys.argv[1:]
    if not args or args[0] in ["-h", "--help", "help"]:
        print("🛰️ Grex CLI — Sovereign Component & Telemetry Utility")
        print("\nCommands:")
        print("  grex status             Show sidecar daemon & container telemetry")
        print("  grex exec <command>     Execute host bash command via sidecar daemon")
        print("  grex version            Show Grex Nexus version")
        return

    cmd = args[0].lower()
    if cmd == "status":
        try:
            req = urllib.request.urlopen("http://host.containers.internal:7777/api/status", timeout=3)
            data = json.loads(req.read().decode("utf-8"))
            print(json.dumps(data, indent=2))
        except Exception:
            try:
                req = urllib.request.urlopen("http://localhost:7777/api/status", timeout=3)
                data = json.loads(req.read().decode("utf-8"))
                print(json.dumps(data, indent=2))
            except Exception as e:
                print(f"Error querying status: {e}")
    elif cmd == "exec":
        if len(args) < 2:
            print("Usage: grex exec <command>")
            return
        cmd_str = " ".join(args[1:])
        try:
            payload = json.dumps({"command": cmd_str}).encode("utf-8")
            req = urllib.request.Request("http://host.containers.internal:7777/api/exec", data=payload, headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=10) as response:
                res = json.loads(response.read().decode("utf-8"))
                print(f"Exit Code: {res.get('exit_code', 0)}")
                if res.get('stdout'):
                    print(f"Stdout:\n{res.get('stdout')}")
                if res.get('stderr'):
                    print(f"Stderr:\n{res.get('stderr')}")
        except Exception:
            try:
                payload = json.dumps({"command": cmd_str}).encode("utf-8")
                req = urllib.request.Request("http://localhost:7777/api/exec", data=payload, headers={"Content-Type": "application/json"})
                with urllib.request.urlopen(req, timeout=10) as response:
                    res = json.loads(response.read().decode("utf-8"))
                    print(f"Exit Code: {res.get('exit_code', 0)}")
                    if res.get('stdout'):
                        print(f"Stdout:\n{res.get('stdout')}")
                    if res.get('stderr'):
                        print(f"Stderr:\n{res.get('stderr')}")
            except Exception as e:
                print(f"Error executing command: {e}")
    elif cmd == "version":
        print("Grex Nexus Sovereign Mothership v1.0.0")
    else:
        print(f"Unknown command: {cmd}. Run 'grex --help' for available commands.")

if __name__ == "__main__":
    main()
